{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/welcome", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/transactions", "destination": "/pages/accounts" },
    { "source": "/hours-tracker", "destination": "/pages/shifts" },
    { "source": "/hours-calendar", "destination": "/pages/hours-calendar" },
    { "source": "/cash-flow", "destination": "/pages/spending" },
    { "source": "/budget", "destination": "/pages/budget" },
    { "source": "/subscriptions", "destination": "/pages/subscriptions" },
    { "source": "/crypto", "destination": "/pages/crypto" },
    { "source": "/insights", "destination": "/pages/insights" },
    { "source": "/settings", "destination": "/pages/settings" },
    { "source": "/import", "destination": "/pages/import" },
    { "source": "/privacy", "destination": "/pages/privacy" },
    { "source": "/terms", "destination": "/pages/terms" },
    { "source": "/add-transaction", "destination": "/pages/add-transaction" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
